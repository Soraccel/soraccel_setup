[Unit]
Description=Recover the Soraccel robot clock from an HTTPS Date header
Wants=network-online.target
After=network-online.target
Before=multi-user.target
StartLimitIntervalSec=10min
StartLimitBurst=20

[Service]
Type=oneshot
ExecStart=/opt/soraccel/setup/scripts/sync-time-https
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
