#!/usr/bin/env bash
set -Eeuo pipefail

setup_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
robot_id=""
pull_images=true
needs_exwayz_license=false
needs_sensors_usb=false

usage() {
  echo "Usage: $0 [--robot-id <id>] [--no-pull]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --robot-id) robot_id="${2:?missing robot id}"; shift 2 ;;
    --no-pull) pull_images=false; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 64 ;;
  esac
done

if [[ $EUID -eq 0 ]]; then
  echo "Run apply as the robot service account, not as root." >&2
  exit 77
fi

if [[ -r /etc/soraccel/robot.env ]]; then
  set -a
  # shellcheck disable=SC1091
  source /etc/soraccel/robot.env
  set +a
  [[ -n "$robot_id" ]] || robot_id="${ROBOT_ID:-}"
fi
[[ "$robot_id" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] || {
  echo "A valid --robot-id is required (or set ROBOT_ID in /etc/soraccel/robot.env)." >&2
  exit 64
}
export SORACCEL_ROBOT_ID="$robot_id"

# Host-facing state is reconciled here, with the same desired robot identity
# used to select the manifest. This makes both interactive shells and the
# user systemd manager expose the value without relying on bootstrap side
# effects.
environment_dir="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
mkdir -p "$environment_dir"
printf 'SORACCEL_ROBOT_ID=%s\n' "$SORACCEL_ROBOT_ID" > "$environment_dir/90-soraccel.conf"
shell_rc="$HOME/.bashrc"
touch "$shell_rc"
if ! grep -Fqx '# Managed by Soraccel apply.' "$shell_rc"; then
  printf '\n# Managed by Soraccel apply.\nexport SORACCEL_ROBOT_ID=%q\n' "$SORACCEL_ROBOT_ID" >> "$shell_rc"
fi
systemctl --user import-environment SORACCEL_ROBOT_ID

deployment_dir="${DEPLOYMENT_DIR:-/opt/soraccel/deployment}"
manifest="$deployment_dir/robots/$robot_id/deployment.yaml"
config_source="$deployment_dir/robots/$robot_id/config"
config_target="/etc/soraccel/config"
state_dir="${XDG_DATA_HOME:-$HOME/.local/share}/soraccel/$robot_id"
runtime_env="${XDG_CONFIG_HOME:-$HOME/.config}/soraccel/$robot_id/runtime.env"
compose_file="$state_dir/compose.yml"
metadata_dir="$(mktemp -d)"
secret_dir="${XDG_CONFIG_HOME:-$HOME/.config}/soraccel/secrets"
exwayz_secret_env="$secret_dir/exwayz.env"
trap 'rm -rf "$metadata_dir"' EXIT

read_exwayz_license() {
  [[ -f "$exwayz_secret_env" ]] || return 1
  local value
  value="$(grep -E '^EXWAYZ_LICENSE_KEY=' "$exwayz_secret_env" | tail -n 1 | cut -d= -f2- || true)"
  [[ -n "$value" ]] || return 1
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || return 1
  printf '%s' "$value"
}

ensure_exwayz_license() {
  local token
  if token="$(read_exwayz_license)"; then
    return 0
  fi
  [[ -r /dev/tty ]] || {
    echo "The deployment includes localization, but no Exwayz license token is stored." >&2
    echo "Run apply interactively once so it can create $exwayz_secret_env." >&2
    exit 77
  }
  read -r -s -p "Exwayz license token: " token </dev/tty
  printf '\n' >/dev/tty
  [[ -n "$token" ]] || { echo "An empty Exwayz license token is not valid." >&2; exit 64; }
  [[ "$token" != *$'\n'* && "$token" != *$'\r'* ]] || {
    echo "The Exwayz license token cannot contain line breaks." >&2
    exit 64
  }
  mkdir -p "$secret_dir"
  chmod 0700 "$secret_dir"
  local previous_umask
  previous_umask="$(umask)"
  umask 077
  printf 'EXWAYZ_LICENSE_KEY=%s\n' "$token" > "$exwayz_secret_env"
  umask "$previous_umask"
  unset token
  chmod 0600 "$exwayz_secret_env"
}

[[ -f "$manifest" ]] || { echo "Missing deployment manifest: $manifest" >&2; exit 66; }
[[ -d "$config_source" ]] || { echo "Missing versioned robot configuration: $config_source" >&2; exit 66; }
[[ -d "$config_target" && -w "$config_target" ]] || {
  echo "Cannot synchronize $config_target; rerun the current bootstrap script." >&2
  exit 77
}

# The deployment repository is the source of truth for non-secret robot
# configuration. Keep this directory flat: image metadata refers to files by
# basename when mounting them into /config.
invalid_config_entry="$(find "$config_source" -mindepth 1 -maxdepth 1 ! -type f -print -quit)"
[[ -z "$invalid_config_entry" ]] || {
  echo "Robot configuration must contain only regular files: $invalid_config_entry" >&2
  exit 65
}
mapfile -t config_files < <(find "$config_source" -mindepth 1 -maxdepth 1 -type f -printf '%f\n' | sort)
for config_file in "${config_files[@]}"; do
  [[ "$config_file" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || {
    echo "Unsupported configuration filename: $config_file" >&2
    exit 65
  }
done

render_config_file() {
  local source="$1" target="$2" tmp
  tmp="$(mktemp)"
  python3 - "$source" "$tmp" <<'PY'
import os
import re
import sys
from pathlib import Path

source = Path(sys.argv[1])
target = Path(sys.argv[2])
rendered = os.path.expandvars(source.read_text(encoding="utf-8"))
unresolved = re.search(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}", rendered)
if unresolved:
    print(
        f"{source} references unset environment variable {unresolved.group(1)!r}",
        file=sys.stderr,
    )
    sys.exit(65)
target.write_text(rendered, encoding="utf-8")
PY
  install -m 0644 "$tmp" "$target"
  rm -f "$tmp"
}

# This target is exclusively managed by apply. Deleting stale files ensures a
# removed configuration cannot silently affect an updated deployment.
find "$config_target" -mindepth 1 -delete
for config_file in "${config_files[@]}"; do
  render_config_file "$config_source/$config_file" "$config_target/$config_file"
done

while IFS=$'\t' read -r component image; do
  [[ -n "$component" && -n "$image" ]] || continue
  if [[ "$component" == "localization" ]]; then
    needs_exwayz_license=true
  fi
  if [[ "$component" == "sensors" ]]; then
    needs_sensors_usb=true
  fi
  if [[ "$pull_images" == true ]]; then
    docker pull "$image"
  fi
  container_id="$(docker create "$image")"
  if ! docker cp "$container_id:/opt/soraccel/repository.yaml" "$metadata_dir/$component.yaml"; then
    docker rm "$container_id" >/dev/null
    echo "Image $image does not contain /opt/soraccel/repository.yaml." >&2
    echo "Publish a component image built with the current component template." >&2
    exit 65
  fi
  docker rm "$container_id" >/dev/null
done < <(python3 "$setup_dir/scripts/render-deployment.py" --manifest "$manifest" --list-images)

if [[ "$needs_exwayz_license" == true ]]; then
  ensure_exwayz_license
fi

if [[ "$needs_sensors_usb" == true ]]; then
  sensors_config="$config_source/sensors.yaml"
  [[ -f "$sensors_config" ]] || {
    echo "The deployment includes sensors, but $sensors_config is missing." >&2
    exit 66
  }
  "$setup_dir/scripts/configure-sensors-usb" \
    --robot-id "$robot_id" \
    --config "$sensors_config" \
    --skip-if-configured
  render_config_file "$sensors_config" "$config_target/sensors.yaml"
fi

python3 "$setup_dir/scripts/render-deployment.py" \
  --manifest "$manifest" \
  --metadata-dir "$metadata_dir" \
  --compose-output "$compose_file" \
  --env-output "$runtime_env"

if [[ "$needs_exwayz_license" == true ]]; then
  {
    printf '\n'
    printf 'EXWAYZ_LICENSE_KEY=%s\n' "$(read_exwayz_license)"
  } >> "$runtime_env"
  chmod 0600 "$runtime_env"
fi

docker compose -f "$compose_file" config --quiet
[[ -d /etc/soraccel/config ]] || { echo "Missing /etc/soraccel/config." >&2; exit 66; }

unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$unit_dir"
mapfile -t services < <(docker compose -f "$compose_file" config --services)

for service in "${services[@]}"; do
  [[ "$service" =~ ^[a-zA-Z0-9_.@-]+$ ]] || {
    echo "Unsupported Compose service name for systemd: $service" >&2
    exit 65
  }
  unit_path="$unit_dir/soraccel-node-${service}.service"
  cat > "$unit_path" <<EOF
# Managed by Soraccel apply. Do not edit: change the Compose service instead.
[Unit]
Description=Soraccel robot component: ${service}
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=${setup_dir}
EnvironmentFile=${runtime_env}
ExecStart=${setup_dir}/scripts/run-service ${compose_file} ${service} up
ExecStop=${setup_dir}/scripts/run-service ${compose_file} ${service} stop
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=default.target
EOF
done

# Remove only old generated units which no longer correspond to this Compose
# manifest. They are stopped first so a removed component cannot keep running.
for unit_path in "$unit_dir"/soraccel-node-*.service; do
  [[ -e "$unit_path" ]] || continue
  grep -qx '# Managed by Soraccel apply. Do not edit: change the Compose service instead.' "$unit_path" || continue
  unit_name="$(basename "$unit_path")"
  service_name="${unit_name#soraccel-node-}"
  service_name="${service_name%.service}"
  if [[ ! " ${services[*]} " =~ " ${service_name} " ]]; then
    systemctl --user disable --now "$unit_name" >/dev/null 2>&1 || true
    rm "$unit_path"
  fi
done

systemctl --user daemon-reload
for service in "${services[@]}"; do
  unit_name="soraccel-node-${service}.service"
  enabled="$(docker compose -f "$compose_file" config --format json | \
    python3 -c 'import json, sys; print(json.load(sys.stdin)["services"][sys.argv[1]].get("labels", {}).get("com.soraccel.enabled-at-boot", "false"))' "$service")"
  if [[ "$enabled" == true ]]; then
    systemctl --user enable "$unit_name" >/dev/null
  else
    systemctl --user disable "$unit_name" >/dev/null 2>&1 || true
  fi
done
printf 'Installed user units:\n'
printf '  soraccel-node-%s.service\n' "${services[@]}"
echo "Use your robot interface or: systemctl --user start soraccel-node-<service>"
